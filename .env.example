# Licensed esports data. Keep the real token in Sites environment variables.
PANDASCORE_TOKEN=

# Supabase Auth project settings. The anon key is designed for client-visible
# usage, but this app still reads it only from the server runtime.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
GOOGLE_OAUTH_ENABLED=false
EMAIL_OTP_ENABLED=false

# Optional production reminder delivery. Keep both secrets server-side.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=赛域 <reminders@example.com>
REMINDER_CRON_SECRET=
REMINDER_UNSUBSCRIBE_SECRET=
REMINDER_SCHEDULER_ENABLED=false
SITE_URL=https://your-domain.example

# Optional Cloudflare Turnstile bot protection for email OTP.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
